    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 42%),
      color-mix(in srgb, currentColor 2%, transparent);
    box-shadow: 0 1.25rem 3.5rem color-mix(in srgb, currentColor 6%, transparent);
  }

  .panel-intro { margin-bottom: 1.5rem; }
  .eyebrow {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .panel-intro h2 {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 4vw, 1.7rem);
    letter-spacing: -0.035em;
  }
  .panel-intro p { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.9rem; }
  form { margin-top: 1rem; }
  form button { white-space: nowrap; }
  form button span { margin-left: 0.35rem; }
  .hint { margin-bottom: 1.25rem; }
  .hint code { color: var(--accent); }
  .status { min-height: 1.2em; margin: -0.5rem 0 1rem; color: var(--muted); font-size: 0.8rem; }
  .empty {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    border-color: var(--panel-border);
  }
  .empty-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    font-size: 1.15rem;
  }
  .empty strong { color: inherit; font-weight: 600; }
  .empty span:last-child { font-size: 0.85rem; }
  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.5rem 0 0.75rem;
  }
  .list-title { margin: 0; font-size: 0.95rem; font-family: var(--font-head); }
  .clear, .bookmark-copy {
    background: transparent;
    color: inherit;
    border: 1px solid var(--panel-border);
    padding: 0.35rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .clear:hover, .bookmark-copy:hover { border-color: var(--accent); }
  .bookmark-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .bookmark-list :global(.bookmark-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--panel-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 2%, transparent);
  }
  .bookmark-list :global(.bookmark-detail) { flex: 1 1 15rem; overflow-wrap: anywhere; font-size: 0.85rem; }
  .bookmark-list :global(.bookmark-link) { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent); text-underline-offset: 0.2em; }
  .bookmark-list :global(.bookmark-link:hover) { color: var(--accent); }
  .bookmark-list :global(.bookmark-copy) { flex: 0 0 auto; }
  [hidden] { display: none !important; }
</style>
