<section class="bookmarks-panel" aria-labelledby="bookmarks-heading">
  <div class="panel-intro">
    <span class="eyebrow">YOUR PERSONAL LINK LIBRARY</span>
    <h2 id="bookmarks-heading">Keep the good ones close.</h2>
    <p>Save a link and get a compact <code>mona-</code> address to find it again.</p>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com/article"
        required
      />
    </div>
    <button type="submit">Save bookmark <span aria-hidden="true">→</span></button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code>. Your links stay on this device.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">
    <span class="empty-icon" aria-hidden="true">↗</span>
    <strong>Your saved links will live here.</strong>
    <span>Add a bookmark above to get started.</span>
  </p>

  <div id="list-header" class="list-header" hidden>
    <h3 class="list-title">Saved bookmarks</h3>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" class="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
    <!-- Bookmarks render here in the browser. -->
  </ul>
</section>

<script>
  import { formatBookmark, loadBookmarks, normalizeUrl, createSlug } from '../lib/bookmarks.mjs';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');
  const clearButton = document.getElementById('clear-all');

  if (
    form instanceof HTMLFormElement &&
    input instanceof HTMLInputElement &&
    list instanceof HTMLUListElement &&
    emptyState instanceof HTMLParagraphElement &&
    listHeader instanceof HTMLDivElement &&
    status instanceof HTMLParagraphElement &&
    clearButton instanceof HTMLButtonElement
  ) {
    let bookmarks = [];

    const render = () => {
      list.replaceChildren();
      const hasBookmarks = bookmarks.length > 0;
      emptyState.hidden = hasBookmarks;
      listHeader.hidden = !hasBookmarks;

      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark-row';

        const link = document.createElement('a');
        link.className = 'bookmark-link';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const formatted = document.createElement('span');
        formatted.className = 'bookmark-detail';
        formatted.append(link, document.createTextNode(` :: ${bookmark.slug}`));

        const copy = document.createElement('button');
        copy.className = 'bookmark-copy';
        copy.type = 'button';
        copy.textContent = 'Copy slug';
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            status.textContent = `Copied ${bookmark.slug}.`;
          } catch {
            status.textContent = 'Could not copy the slug. Select and copy it from the bookmark.';
          }
        });

        row.append(formatted, copy);
        list.append(row);
      }
    };

    const persist = () => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(bookmarks));
        return true;
      } catch {
        status.textContent = 'Could not save bookmarks in this browser.';
        return false;
      }
    };

    try {
      bookmarks = loadBookmarks(localStorage.getItem(storageKey));
    } catch {
      bookmarks = [];
      status.textContent = 'Could not read saved bookmarks in this browser.';
    }
    render();

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.textContent = '';

      try {
        const url = normalizeUrl(input.value);
        if (bookmarks.some((bookmark) => bookmark.url === url)) {
          status.textContent = 'That link is already saved.';
          return;
        }

        const slug = createSlug(bookmarks.map((bookmark) => bookmark.slug));
        const nextBookmarks = [...bookmarks, { url, slug }];
        const previousBookmarks = bookmarks;
        bookmarks = nextBookmarks;
        if (!persist()) {
          bookmarks = previousBookmarks;
          return;
        }

        render();
        form.reset();
        input.focus();
        status.textContent = `Saved ${formatBookmark({ url, slug })}.`;
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Enter a valid web URL.';
      }
    });

    clearButton.addEventListener('click', () => {
      if (bookmarks.length === 0) return;
      const previousBookmarks = bookmarks;
      bookmarks = [];
      if (!persist()) {
        bookmarks = previousBookmarks;
        return;
      }
      render();
      status.textContent = 'All bookmarks cleared.';
    });
  }
</script>

<style>
